# Public browser configuration. Values in this file are examples only.
# Do not add server-side or privileged secrets here: Vite exposes VITE_* values to users' browsers.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional release metadata and feature flags.
VITE_APP_VERSION=local
VITE_COMMIT_SHA=local
VITE_ENABLE_CHAT=false
VITE_ENABLE_CHAT_V2=false
VITE_ENABLE_REQUEST_APPROVAL_PHASE1=false
VITE_ENABLE_PURCHASE_PACKAGE_V2=false
VITE_PURCHASE_PACKAGE_V2_SITE_IDS=
VITE_ENABLE_PERF02_WMS_PAGING=false
VITE_ENABLE_PERF02_REQUEST_PAGING=false

# This is a public key used by the browser for push subscription; it is not a private VAPID key.
VITE_VAPID_PUBLIC_KEY=

# Edge Function secrets are set with Supabase Cloud secrets, not in this file:
# SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY, GOOGLE_API_KEY,
# VAPID_PRIVATE_KEY, SEND_WEB_PUSH_SECRET
